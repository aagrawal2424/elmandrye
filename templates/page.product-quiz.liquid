  function recommendedProductCard(description, handle, title, url, image, id, plan_id) {
    var template = '<div class="product-card" data-handle="' + handle + '" data-id="' + id + '" data-plan_id="' + plan_id + '"><div class="remove-item" onclick="removeItem(this);"></div><div class="product-card-header"><img src="' + image + '" /></div><div class="product-card-body"><p class="product-card-desc">' + description + '</p><p class="we-recc">We recommend</p><p class="p-title">' + title + '</p></div><div class="product-card-footer"></div></div>';
    // if data-handle already exists in the container, don't do anything.
    $(".recommendation-container").prepend(template);
    var found = {};
    $('[data-handle]').each(function(){
       var $this = $(this);
       if(found[$this.data('handle')]){
          $this.remove();   
       } else {
         found[$this.data('handle')] = true;   
       }
    });
  }

function removeItem(el) {
  if (confirm('Are you sure you want to remove this supplement from your bag?')) {
    $.ajax({
      type: "POST",
      url: "/cart/change.js",
      dataType: "json",
      data: {
        id: parseFloat($(el).parent().data('id')),
        quantity: 0,
      },
    }).then((data) => {
      console.log($(el).parent().data('id') + ' removed from cart.');
    });
    $(el).parent().remove();
  }
}
  

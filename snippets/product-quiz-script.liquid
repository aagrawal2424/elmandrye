    console.log(JSON.stringify(sender.data, null, 3));
    surveyResult(sender.data);
    setCookie('survey',  'completed', 1);
  });
  $("#surveyElement").Survey({
    model: survey
    // goNextPageAutomatic: true
  });

  survey.onAfterRenderQuestion.add(function () {
    $(".sd-element .sd-item.sd-radio label").click(function() {
      $(".sd-navigation__next-btn").click();
      if($('.sd-navigation__complete-btn').css('display') != 'none') {
        $(".sd-navigation__complete-btn").click();
      }
    });
  });

  function animate(animitionType, duration) {
    if (! duration) 
      duration = 1000;

    var element = document.getElementById("surveyElement");
    //     $(element).velocity(animitionType, {duration: duration});
  }
  var doAnimantion = true;
  survey.onCurrentPageChanging.add(function (sender, options) {
    if (! doAnimantion) 
      return;

    options.allowChanging = false;
    setTimeout(function () {
      doAnimantion = false;
      sender.currentPage = options.newCurrentPage;
      doAnimantion = true;
    }, 500);
    $("#surveyElement").css('opacity', 0);
  });
  survey.onCurrentPageChanged.add(function (sender) {
    $("#surveyElement").css('opacity', 1);
  });
  survey.onCompleting.add(function (sender, options) {
    if (! doAnimantion) 
      return;

    options.allowComplete = false;
    setTimeout(function () {
      doAnimantion = false;
      sender.doComplete();
      doAnimantion = true;
    }, 500);
    $("#surveyElement").css('opacity', 0);
  });

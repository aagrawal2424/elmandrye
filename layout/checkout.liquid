<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ direction }}" class="{{ checkout_html_classes }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, user-scalable=0">
    <meta name="referrer" content="origin">

    <title>{{ page_title }}</title>

    <script src="https://code.jquery.com/jquery-3.6.1.min.js"integrity="sha256-o88AwQnZB+VDvE9tvIXrMQaPlFFSUTR+nldQm1LuPXQ="crossorigin="anonymous"></script>
    <script>console.log('hello123');</script>
    {{ content_for_header }}

    {{ checkout_stylesheets }}
    {{ checkout_scripts }}

    <!--Route Code Edited 5/10/2023-->
    <script type="text/javascript" src="https://cdn.routeapp.io/route-widget-shopify/v2/route-widget-shopify-stable-v2.min.js" id="route-script" reload-products-and-price-separately-checkout></script>
        <style> 
    
         .route-div::after{
             content: "We understand that things happen in transit!\A That's why Elm & Rye offers this premium service to protect\A your purchase from theft, damaged, or lost shipments.\A Stay opted in to protect this order!";
             white-space: pre-wrap;
             display: inline-block;
             margin-bottom: 15px;
             margin-top: -15px;
           }       
         .route-div{
             text-align: center;
             font-size: 12px;
             line-height: 15px;
           }
        </style>
    <!--End Route Code-->
    
  </head>
  <body>
    {{ skip_to_content_link }}

    <header class="banner" data-header role="banner">
      <div class="wrap">
        {{ content_for_logo }}
      </div>
    </header>

    {{ order_summary_toggle }}
    <div class="content" data-content>
      <div class="wrap">
        <div class="main">
          <header class="main__header" role="banner">
            {{ content_for_logo }}
            {{ breadcrumb }}
            {{ alternative_payment_methods }}
          </header>

          <!--Route Code Edited 9/18/2023-->
          {% if content_for_layout contains 'data-step="contact_information"' or content_for_layout contains 'data-step="shipping_method"' %}
             <div class="route-div" id="route-script" reload-products-and-price-separately-checkout desktop-align="center"></div>
          {% endif %}
          <!--End Route Code-->  
          
          <main class="main__content" role="main">
            {{ content_for_layout }}
          </main>
          <footer class="main__footer" role="contentinfo">
            {{ content_for_footer }}
          </footer>
        </div>
        <aside class="sidebar" role="complementary">
          <div class="sidebar__header">
            {{ content_for_logo }}
          </div>
          <div class="sidebar__content">
            {{ content_for_order_summary }}
          </div>
        </aside>
      </div>
    </div>

    {{ tracking_code }}
  <div data-rebuy-id="68204"></div>
<script async src="https://cdn.rebuyengine.com/onsite/js/rebuy.js?shop=elmandrye.myshopify.com"></script>
    <script>
    jQuery(function($) {
      function phoneToggle() {
        if ( $("#checkout_shipping_address_country").val() == 'United States') {
          $("#checkout_shipping_address_phone").prop('required', false);
          $("#checkout_shipping_address_phone").attr("placeholder", "Phone (Optional)");
          $("label[for='checkout_shipping_address_phone']").html("Phone (Optional)");
          $(".step[data-step='contact_information'] #continue_button").removeClass('disable-continue');
        } else {
          $("#checkout_shipping_address_phone").prop('required', true);
          $("#checkout_shipping_address_phone").attr("placeholder", "Phone (Required)");
          $("label[for='checkout_shipping_address_phone']").html("Phone (Required)");
          if( $("#checkout_shipping_address_phone").val() ) {
            $(".step[data-step='contact_information'] #continue_button").removeClass('disable-continue');
          } else {
            $(".step[data-step='contact_information'] #continue_button").addClass('disable-continue');
          }
        } 
      }
      phoneToggle();
      $(".fieldset input, .fieldset select").change(function() {
        const inputDelay = setTimeout(phoneToggle, 200);
      });
      $(".fieldset input, .fieldset select").on("keypress", function() {
        const inputDelay = setTimeout(phoneToggle, 200);
      });
    });
  </script>
</body>
</html>
